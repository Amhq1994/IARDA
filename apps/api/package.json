{
  "name": "@iarda/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "@iarda/shared": "1.0.0",
    "fastify": "5.12.8",
    "@fastify/cookie": "11.1.5",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@node-rs/argon2": "2.2.2",
    "qrcode": "1.5.4",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/pg": "8.23.1",
    "@types/node": "22.20.7",
    "@types/qrcode": "1.5.6"
  }
}

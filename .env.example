# Copy to .env and fill in. Never commit .env. Generate secrets with:  openssl rand -base64 32
# --- database (docker compose) ---
DB_OWNER_PASSWORD=
# least-privilege runtime role created automatically on first start
APP_DB_PASSWORD=
# --- security ---
# 32 bytes, base64. Encrypts personal data and attachments: back it up safely and never change it after go-live.
DATA_ENCRYPTION_KEY=
INTEGRATION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# --- data ---
# "demo" loads demonstration data once (testing only). Leave empty for production.
SEED_MODE=
# --- e-mail (optional; without it e-mails are kept in the outbox) ---
SMTP_URL=
SMTP_FROM=
# --- single sign-on (optional, Azure AD / Entra ID) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
# --- web ---
APP_PORT=3000
# set to false only when testing without TLS
COOKIE_SECURE=true
